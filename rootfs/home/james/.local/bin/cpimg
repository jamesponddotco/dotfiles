#!/usr/bin/env bash

# Set bash to "strict mode" to make it more robust, reliable and maintainable.
set -o errexit -o errtrace -o pipefail -o nounset
shopt -s nullglob
unset CDPATH
IFS=$'\n\t'
LC_ALL='C'

checks() {
  if ! command -v curl >/dev/null 2>&1; then
    printf 'curl is not installed.\n'
    exit 1
  fi

  if ! command -v acopw >/dev/null 2>&1; then
    printf 'acopw is not installed.\n'
    exit 1
  fi

  if ! command -v imgdiet >/dev/null 2>&1; then
    printf 'imgdiet is not installed.\n'
    exit 1
  fi

  if ! command -v security >/dev/null 2>&1; then
    printf 'security is not installed.\n'
    exit 1
  fi

  if [[ -z "${1}" ]]; then
    printf 'Image input file missing.\n'
    exit 1
  fi

  if [[ ! "${1}" =~ \.(gif|jpg|jpeg|png)$ ]]; then
    printf 'Image must be a GIF, JPG, or PNG file.\n'
    exit 1
  fi
}

main() {
  mkdir -p '/tmp/cpimg'

  local image_filename
  image_filename="$(acopw random --length 16 --numbers --lowercase).${1##*.}"
  readonly image_filename

  imgdiet --optimize-icc-profile "${1}" "/tmp/cpimg/${image_filename}"

  local access_key
  access_key="$(security find-generic-password -w -s \
    'cpimg-access-key')"
  readonly access_key

  curl \
    --url "https://storage.bunnycdn.com/cpimgdotsh/${image_filename}" \
    --tlsv1.3 \
    --proto '=https' \
    --silent \
    --output '/dev/null' \
    --request 'PUT' \
    --header "AccessKey: ${access_key}" \
    --upload-file "/tmp/cpimg/${image_filename}"

  rm -rf '/tmp/cpimg'

  printf 'https://i.cpimg.sh/%s\n' "${image_filename}"
}

checks "${1}"
main "${1}"

# All was well.
exit 0
